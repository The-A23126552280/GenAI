# Copy this file to .env and fill in your keys

# LLM provider (default: groq)
LLM_PROVIDER=groq

# Model ID as known by the provider (must be currently available)
# Recommended free-tier options on Groq (Nov 2026):
#   qwen/qwen3.8-27b
#   openai/gpt-oss-20b
#   openai/gpt-oss-120b
LLM_MODEL_NAME=openai/gpt-oss-20b

# Groq API key (https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# Tavily API key (https://tavily.com) — optional; falls back to LLM research
TAVILY_API_KEY=tvly_your_key_here

# Editor approval threshold (1-10)
REVIEW_THRESHOLD=7

# Maximum write/edit loops before forcing finish
MAX_REVISIONS=1
